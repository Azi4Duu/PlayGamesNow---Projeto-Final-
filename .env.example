APP_NAME="Play Games Now"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug


# --------------------------------------------------
# DATABASE
# --------------------------------------------------

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=play_games_now
DB_USERNAME=root
DB_PASSWORD=


# --------------------------------------------------
# SESSION / CACHE / QUEUE
# --------------------------------------------------

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file

QUEUE_CONNECTION=sync


# --------------------------------------------------
# FILE STORAGE
# --------------------------------------------------

FILESYSTEM_DISK=public


# --------------------------------------------------
# EMAIL
# --------------------------------------------------
# Required for:
# - Email verification
# - Password reset
# - Two-factor authentication
# - Purchase receipt delivery
#
# For Gmail, use an App Password.

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="${MAIL_USERNAME}"
MAIL_FROM_NAME="${APP_NAME}"


# --------------------------------------------------
# GOOGLE OAUTH
# --------------------------------------------------
# Required only for "Sign in with Google".

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback


# --------------------------------------------------
# FRONTEND
# --------------------------------------------------

VITE_APP_NAME="${APP_NAME}"
